# Entorno virtual
venv/
.venv/
env/

# Archivos de Python
__pycache__/
*.py[cod]
*$py.class

# Base de datos local
*.db
*.sqlite3

# Archivos de configuración local de VS Code (opcional, pero recomendado)
.vscode/*
!.vscode/settings.json
!.vscode/launch.json
!.vscode/tasks.json

# Archivos del sistema operativo
.DS_Store
Thumbs.db

# Archivos de empaquetado (PyInstaller)
build/
dist/
*.spec